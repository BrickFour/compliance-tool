# Copy to ".env" in the repository root for local use. On a host, configure environment variables there.
# Frontend variables must use the VITE_ prefix; only those are exposed in the browser bundle.

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=compliance_tracker

# --- Server ---
PORT=8000
# Set to "production" on the live host (enables HTTPS-only cookies and requires SESSION_SECRET).
NODE_ENV=development
# Behind a proxy/load balancer set to 1 so client IPs and HTTPS are detected correctly.
TRUST_PROXY=

# --- Sign-in ---
# Long random string (32+ chars). Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Used only when there are no users yet: creates the first admin. Remove ADMIN_PASSWORD afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Demo only: 'on' shows one-click sign-in buttons for demo users. Leave off for real data.
DEMO_QUICK_ACCESS=off

# --- Ask AI chatbot (optional) ---
# Key from aistudio.google.com; Gemini is used first when set.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_SEARCH_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Key from console.anthropic.com; used when GEMINI_API_KEY is not set.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Regulatory Updates (optional) ---
# Uses the same GEMINI_API_KEY / ANTHROPIC_API_KEY as Ask AI.
# REGULATORY_AI_PER_RUN=15
# REGULATORY_LATEST_PER_SOURCE=5
# REGULATORY_OCR_PER_RUN=8
# Set to "off" to stop the daily scheduler (enabled by default).
# REGULATORY_MONITORING=on
# REGULATORY_TIME_BUDGET_MS=45000
# REGULATORY_ARCHIVE_DAYS=180

# --- Vercel only ---
# CRON_SECRET=

# --- Demo-data migration (optional) ---
# DEMO_PASSWORD=
# DEMO_COMPANY=Aakar Demo Developers

